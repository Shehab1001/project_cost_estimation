<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Cost Estimation Module Category -->
        <record id="module_category_cost_estimation" model="ir.module.category">
            <field name="name">Project Cost Estimation</field>
            <field name="description">Manage cost estimate approvals for projects</field>
            <field name="sequence">20</field>
        </record>

        <!--
            Cost Approver Group
            Members of this group can approve or reject submitted cost estimates.
            They inherit project user access so they can view projects.
        -->
        <record id="group_cost_approver" model="res.groups">
            <field name="name">Cost Estimate Approver</field>
            <field name="category_id" ref="module_category_cost_estimation"/>
            <field name="comment">
                Members can view submitted cost estimates and approve or reject them.
                They cannot create or modify estimate records.
            </field>
            <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        </record>

    </data>
</odoo>
